{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Movable Typo",
  "version": "0.1.0",
  "identifier": "codes.typo.movable-typo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Movable Typo",
        "width": 1500,
        "height": 950,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright \u00a9 2026 Tyler Paige. PolyForm Strict License 1.0.0."
  }
}